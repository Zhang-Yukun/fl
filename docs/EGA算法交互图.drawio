<mxfile host="app.diagrams.net" agent="Codex" version="26.0.11">
  <diagram id="ega-main" name="EGA 主流程">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" math="1" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t" value="EGA-FedAvg 逻辑图 / Encoded Gradient Aggregation in This Framework" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#111827;fontColor=#FFFFFF;strokeColor=#111827;fontStyle=1;fontSize=24;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1740" height="60" as="geometry"/></mxCell>
        <mxCell id="s" value="服务器 / Server" style="swimlane;rounded=1;whiteSpace=wrap;html=1;startSize=36;fillColor=#E0F2FE;strokeColor=#0284C7;fontStyle=1;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="1720" height="290" as="geometry"/></mxCell>
        <mxCell id="s1" value="Step 0&#xa;初始化 EGA codec&#xa;`load_ega_codec(...)`&#xa;若 artifact 缺失，可先 synthetic pretrain" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;fontSize=14;" vertex="1" parent="s"><mxGeometry x="20" y="70" width="230" height="100" as="geometry"/></mxCell>
        <mxCell id="s2" value="Step 1&#xa;构造 `round_context`&#xa;包含 `ega_normalization`&#xa;首轮额外包含 `ega_codec_payload`" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;fontSize=14;" vertex="1" parent="s"><mxGeometry x="270" y="70" width="220" height="100" as="geometry"/></mxCell>
        <mxCell id="s3" value="Step 2&#xa;下载路径: dense model download&#xa;`download_method = dense`, `download_dtype = float32`&#xa;客户端本地执行接收态重建" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=14;" vertex="1" parent="s"><mxGeometry x="510" y="70" width="240" height="100" as="geometry"/></mxCell>
        <mxCell id="s4" value="Step 3&#xa;等待所有客户端上传 `ega_payload` + buffer update&#xa;同步屏障" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontStyle=1;fontSize=14;" vertex="1" parent="s"><mxGeometry x="770" y="70" width="220" height="100" as="geometry"/></mxCell>
        <mxCell id="s5" value="Step 4&#xa;对全部 `ega_payload` 做 `decode_mean_encoded_payload(...)`&#xa;得到 trainable 部分的平均 update" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=14;" vertex="1" parent="s"><mxGeometry x="1010" y="70" width="270" height="100" as="geometry"/></mxCell>
        <mxCell id="s6" value="Step 5&#xa;把各客户端 dense buffer update 按权重加回&#xa;组成 full update" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=14;" vertex="1" parent="s"><mxGeometry x="1300" y="70" width="200" height="100" as="geometry"/></mxCell>
        <mxCell id="s7" value="Step 6&#xa;基于 client-visible protocol base 聚合&#xa;更新 `server.global_state`" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=14;" vertex="1" parent="s"><mxGeometry x="1520" y="70" width="180" height="100" as="geometry"/></mxCell>
        <mxCell id="s8" value="Step 7&#xa;更新 `server.ega_normalization`&#xa;此图采用 `ema_reported_client_max_abs`, `normalization_ema = 0.9`" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;fontSize=14;" vertex="1" parent="s"><mxGeometry x="430" y="190" width="420" height="72" as="geometry"/></mxCell>
        <mxCell id="s9" value="Step 8&#xa;EGA attack view&#xa;`decode_attack_view_from_mean_difference(...)`&#xa;再与目标客户端 buffer update 合并" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontSize=14;" vertex="1" parent="s"><mxGeometry x="900" y="190" width="360" height="72" as="geometry"/></mxCell>
        <mxCell id="s10" value="Step 9&#xa;通信量统计&#xa;encoded payload 用 `payload.nbytes` / `payload.num_parameters`&#xa;download 还要加 `round_context` 的辅助字节" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;fontSize=14;" vertex="1" parent="s"><mxGeometry x="1310" y="190" width="390" height="72" as="geometry"/></mxCell>
        <mxCell id="c1" value="客户端 A / Client A" style="swimlane;rounded=1;whiteSpace=wrap;html=1;startSize=34;fillColor=#ECFCCB;strokeColor=#65A30D;fontStyle=1;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="390" height="620" as="geometry"/></mxCell>
        <mxCell id="c1a" value="Step 1&#xa;首轮接收 `round_context.ega_codec_payload`&#xa;执行 `load_ega_codec_payload(...)`&#xa;后续轮次复用本地 codec" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FEE7;strokeColor=#84CC16;fontSize=14;" vertex="1" parent="c1"><mxGeometry x="20" y="60" width="350" height="86" as="geometry"/></mxCell>
        <mxCell id="c1b" value="Step 2&#xa;执行 `prepare_client_state(...)`&#xa;按 dense model path 接收 `download_state`&#xa;再恢复训练用 `received_state`" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FEE7;strokeColor=#84CC16;fontSize=14;" vertex="1" parent="c1"><mxGeometry x="20" y="166" width="350" height="86" as="geometry"/></mxCell>
        <mxCell id="c1c" value="Step 3&#xa;得到 client-visible 模型 \(C_{A,r}\)&#xa;本地训练得到 \(L_{A,r}\)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#65A30D;fontSize=14;" vertex="1" parent="c1"><mxGeometry x="20" y="272" width="350" height="74" as="geometry"/></mxCell>
        <mxCell id="c1d" value="Step 4&#xa;拆分 trainable / untrainable 部分&#xa;trainable update 进入 EGA 编码支路&#xa;buffer update 进入 dense 支路" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#65A30D;fontSize=14;" vertex="1" parent="c1"><mxGeometry x="20" y="366" width="350" height="86" as="geometry"/></mxCell>
        <mxCell id="c1e" value="Step 5&#xa;`error_feedback = true`&#xa;先把 residual 加回 trainable update" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#22C55E;fontSize=14;" vertex="1" parent="c1"><mxGeometry x="20" y="472" width="350" height="62" as="geometry"/></mxCell>
        <mxCell id="c1f" value="Step 6&#xa;执行 `encode_state_update(...)`&#xa;flatten -&gt; contribution_scale -&gt; block pack(`block_size = 256`)&#xa;-&gt; stochastic quantize(`q = 127`) -&gt; codec.encode_blocks(`encoded_dim = 128`)&#xa;-&gt; transport cast(`encoded_dtype = int8`)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=14;" vertex="1" parent="c1"><mxGeometry x="20" y="554" width="350" height="98" as="geometry"/></mxCell>
        <mxCell id="c1g" value="Step 7&#xa;用单客户端 decode 近似重建&#xa;并更新 residual" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#22C55E;fontSize=14;" vertex="1" parent="c1"><mxGeometry x="20" y="672" width="350" height="62" as="geometry"/></mxCell>
        <mxCell id="c1h" value="Step 8&#xa;返回 `ega_payload` + `aggregation_state=buffer_update`" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=14;" vertex="1" parent="c1"><mxGeometry x="20" y="754" width="350" height="62" as="geometry"/></mxCell>
        <mxCell id="c2" value="客户端 B / Client B" style="swimlane;rounded=1;whiteSpace=wrap;html=1;startSize=34;fillColor=#ECFCCB;strokeColor=#65A30D;fontStyle=1;fontSize=18;" vertex="1" parent="1"><mxGeometry x="470" y="430" width="390" height="620" as="geometry"/></mxCell>
        <mxCell id="c2a" value="与 Client A 相同的 EGA pipeline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAF9;strokeColor=#78716C;fontSize=15;fontStyle=1;" vertex="1" parent="c2"><mxGeometry x="20" y="60" width="350" height="40" as="geometry"/></mxCell>
        <mxCell id="c2b" value="1. load / reuse codec" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FEE7;strokeColor=#84CC16;fontSize=14;" vertex="1" parent="c2"><mxGeometry x="20" y="124" width="350" height="48" as="geometry"/></mxCell>
        <mxCell id="c2c" value="2. prepare_client_state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FEE7;strokeColor=#84CC16;fontSize=14;" vertex="1" parent="c2"><mxGeometry x="20" y="192" width="350" height="48" as="geometry"/></mxCell>
        <mxCell id="c2d" value="3. local train to get \(L_{B,r}\)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#65A30D;fontSize=14;" vertex="1" parent="c2"><mxGeometry x="20" y="260" width="350" height="48" as="geometry"/></mxCell>
        <mxCell id="c2e" value="4. split trainable update vs buffer update" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#65A30D;fontSize=14;" vertex="1" parent="c2"><mxGeometry x="20" y="328" width="350" height="48" as="geometry"/></mxCell>
        <mxCell id="c2f" value="5. encoded upload branch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=14;" vertex="1" parent="c2"><mxGeometry x="20" y="396" width="350" height="48" as="geometry"/></mxCell>
        <mxCell id="c2g" value="6. update residual" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#22C55E;fontSize=14;" vertex="1" parent="c2"><mxGeometry x="20" y="464" width="350" height="48" as="geometry"/></mxCell>
        <mxCell id="c2h" value="7. return `ega_payload` + buffer_update" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=14;" vertex="1" parent="c2"><mxGeometry x="20" y="532" width="350" height="48" as="geometry"/></mxCell>
        <mxCell id="c3" value="客户端 C / Client C" style="swimlane;rounded=1;whiteSpace=wrap;html=1;startSize=34;fillColor=#ECFCCB;strokeColor=#65A30D;fontStyle=1;fontSize=18;" vertex="1" parent="1"><mxGeometry x="900" y="430" width="390" height="620" as="geometry"/></mxCell>
        <mxCell id="c3a" value="与 Client A 相同的 EGA pipeline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAF9;strokeColor=#78716C;fontSize=15;fontStyle=1;" vertex="1" parent="c3"><mxGeometry x="20" y="60" width="350" height="40" as="geometry"/></mxCell>
        <mxCell id="c3b" value="1. load / reuse codec" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FEE7;strokeColor=#84CC16;fontSize=14;" vertex="1" parent="c3"><mxGeometry x="20" y="124" width="350" height="48" as="geometry"/></mxCell>
        <mxCell id="c3c" value="2. prepare_client_state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FEE7;strokeColor=#84CC16;fontSize=14;" vertex="1" parent="c3"><mxGeometry x="20" y="192" width="350" height="48" as="geometry"/></mxCell>
        <mxCell id="c3d" value="3. local train to get \(L_{C,r}\)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#65A30D;fontSize=14;" vertex="1" parent="c3"><mxGeometry x="20" y="260" width="350" height="48" as="geometry"/></mxCell>
        <mxCell id="c3e" value="4. split trainable update vs buffer update" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#65A30D;fontSize=14;" vertex="1" parent="c3"><mxGeometry x="20" y="328" width="350" height="48" as="geometry"/></mxCell>
        <mxCell id="c3f" value="5. encoded upload branch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=14;" vertex="1" parent="c3"><mxGeometry x="20" y="396" width="350" height="48" as="geometry"/></mxCell>
        <mxCell id="c3g" value="6. optional error feedback update" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#22C55E;fontSize=14;" vertex="1" parent="c3"><mxGeometry x="20" y="464" width="350" height="48" as="geometry"/></mxCell>
        <mxCell id="c3h" value="7. return `ega_payload` + buffer_update" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=14;" vertex="1" parent="c3"><mxGeometry x="20" y="532" width="350" height="48" as="geometry"/></mxCell>
        <mxCell id="note1" value="参考配置画像 / Reference Profile&#xa;`artifact_path = artifacts/ega/ega_ed128_dm_ega_pc_q127.pt`&#xa;`block_size = 256`, `encoded_dim = 128`&#xa;`hidden_dim = 1024`, `residual_blocks = 2`&#xa;`quantization_level = 127`, `encoded_dtype = int8`&#xa;`download_method = dense`, `download_dtype = float32`&#xa;`error_feedback = true`&#xa;`normalization_strategy = ema_reported_client_max_abs`&#xa;`normalization_ema = 0.9`" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1320" y="430" width="440" height="220" as="geometry"/></mxCell>
        <mxCell id="note2" value="符号说明 / Notation&#xa;\(G_r\): 第 \(r\) 轮开始时服务器 protocol 全局模型&#xa;\(C_{i,r}\): 客户端 \(i\) 实际收到并训练的模型&#xa;\(L_{i,r}\): 本地训练结束后的模型&#xa;\(U_{i,r}\): 上传前的本地 update&#xa;`ega_payload`: trainable update 的编码上传内容&#xa;`aggregation_state`: 与 `ega_payload` 同传的 dense buffer update&#xa;上传语义固定为 `update`，下载语义固定为 `model`" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAF9;strokeColor=#78716C;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1320" y="680" width="440" height="220" as="geometry"/></mxCell>
        <mxCell id="note3" value="补充说明 / Details&#xa;1. 压缩发生在客户端上传支路: block pack -&gt; quantize -&gt; codec encode -&gt; int8 cast。&#xa;2. 通信量统计位置见 Server Step 9，下载还要计入 `round_context`。&#xa;3. 攻击位置见 Server Step 8，通过 mean-difference attack view 从 encoded payload 重建观察视图。&#xa;4. 图中所有步骤都按这组配置直接执行。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontSize=15;dashed=1;" vertex="1" parent="1"><mxGeometry x="1320" y="930" width="440" height="120" as="geometry"/></mxCell>
        <mxCell id="e1" value="`round_context` with normalization + optional codec payload" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284C7;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="s2" target="c1a"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="same" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284C7;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="s2" target="c2a"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="same" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284C7;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="s2" target="c3a"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="`ega_payload` + buffer_update" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16A34A;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="c1h" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="`ega_payload` + buffer_update" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16A34A;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="c2h" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="`ega_payload` + buffer_update" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16A34A;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="c3h" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
