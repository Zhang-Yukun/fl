        <mxCell id="b-c3" value="客户端 C / La2O3" style="swimlane;rounded=1;whiteSpace=wrap;html=1;startSize=34;fillColor=#ECFCCB;strokeColor=#65A30D;fontStyle=1;fontSize=18;" vertex="1" parent="1"><mxGeometry x="940" y="390" width="420" height="520" as="geometry"/></mxCell>
        <mxCell id="b-c3-1" value="1. 接收完整模型 \(G_r\)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FEE7;strokeColor=#84CC16;fontSize=14;" vertex="1" parent="b-c3"><mxGeometry x="20" y="60" width="380" height="52" as="geometry"/></mxCell>
        <mxCell id="b-c3-2" value="2. 重建 \(C_{C,r}\) 并本地训练得到 \(L_{C,r}\)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#65A30D;fontSize=14;" vertex="1" parent="b-c3"><mxGeometry x="20" y="132" width="380" height="62" as="geometry"/></mxCell>
        <mxCell id="b-c3-3" value="3. 默认上传 update&#xa;\(P^{up}_{C,r}=L_{C,r}-C_{C,r}\)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#65A30D;fontSize=14;" vertex="1" parent="b-c3"><mxGeometry x="20" y="214" width="380" height="62" as="geometry"/></mxCell>
        <mxCell id="b-c3-4" value="4. 在客户端内部做压缩 / 量化 / 编码&#xa;然后返回 payload_C" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=14;" vertex="1" parent="b-c3"><mxGeometry x="20" y="296" width="380" height="72" as="geometry"/></mxCell>
        <mxCell id="b-note" value="说明&#xa;默认设定固定为: `upload_mode=update`, `download_mode=model`, `evaluation.mode=protocol`。&#xa;通信量仍在 `server.record_round(...)` 中汇总。&#xa;异步仅指攻击队列异步，不是联邦聚合异步。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1460" y="390" width="300" height="240" as="geometry"/></mxCell>
        <mxCell id="b-e1" value="download" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284C7;strokeWidth=2;fontSize=13;" edge="1" parent="1" source="b-s1" target="b-c1-1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b-e2" value="download" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284C7;strokeWidth=2;fontSize=13;" edge="1" parent="1" source="b-s1" target="b-c2-1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b-e3" value="download" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284C7;strokeWidth=2;fontSize=13;" edge="1" parent="1" source="b-s1" target="b-c3-1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b-e4" value="upload_A" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16A34A;strokeWidth=2;fontSize=13;" edge="1" parent="1" source="b-c1-4" target="b-s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b-e5" value="upload_B" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16A34A;strokeWidth=2;fontSize=13;" edge="1" parent="1" source="b-c2-4" target="b-s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b-e6" value="upload_C" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16A34A;strokeWidth=2;fontSize=13;" edge="1" parent="1" source="b-c3-4" target="b-s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b-e7" value="submit attack snapshot" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#DC2626;strokeWidth=2;fontSize=13;" edge="1" parent="1" source="b-s6" target="b-q1"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="default-multi-sync" name="多节点同步">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="1" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c-title" value="多节点同步联邦训练（默认语义） / Multi-Node Synchronous FL via gRPC (Default Semantics)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#111827;fontColor=#FFFFFF;strokeColor=#111827;fontStyle=1;fontSize=23;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1740" height="60" as="geometry"/></mxCell>
        <mxCell id="c-server" value="gRPC 协调服务器 / Coordinator" style="swimlane;rounded=1;whiteSpace=wrap;html=1;startSize=36;fillColor=#E0F2FE;strokeColor=#0284C7;fontStyle=1;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="1720" height="240" as="geometry"/></mxCell>
        <mxCell id="c-s1" value="Step 1&#xa;持有服务器全局模型 \(G_r\)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;fontSize=14;" vertex="1" parent="c-server"><mxGeometry x="20" y="70" width="200" height="84" as="geometry"/></mxCell>
        <mxCell id="c-s2" value="Step 2&#xa;GetGlobal RPC 返回完整模型&#xa;默认下载语义: \(P^{down}_{i,r}=G_r\)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;fontSize=14;" vertex="1" parent="c-server"><mxGeometry x="240" y="70" width="250" height="84" as="geometry"/></mxCell>
        <mxCell id="c-s3" value="Step 3&#xa;等待三个 SubmitUpdate RPC 全部到达&#xa;同步屏障" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontStyle=1;fontSize=14;" vertex="1" parent="c-server"><mxGeometry x="510" y="70" width="230" height="84" as="geometry"/></mxCell>
        <mxCell id="c-s4" value="Step 4&#xa;解码上传得到 \(\hat{U}_{i,r}\)&#xa;聚合得到 \(G_{r+1}\)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=14;" vertex="1" parent="c-server"><mxGeometry x="760" y="70" width="220" height="84" as="geometry"/></mxCell>
        <mxCell id="c-s5" value="Step 5&#xa;按 protocol 口径评测当前全局模型" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;fontSize=14;" vertex="1" parent="c-server"><mxGeometry x="1000" y="70" width="210" height="84" as="geometry"/></mxCell>
        <mxCell id="c-s6" value="Step 6&#xa;统计通信量&#xa;参数字节在 `record_round` 中汇总&#xa;实际传输字节来自 RPC counters" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;fontSize=14;" vertex="1" parent="c-server"><mxGeometry x="1230" y="70" width="240" height="84" as="geometry"/></mxCell>
        <mxCell id="c-s7" value="Step 7&#xa;在本轮尾部执行攻击&#xa;同步模式等待攻击结束" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontSize=14;" vertex="1" parent="c-server"><mxGeometry x="1490" y="70" width="210" height="84" as="geometry"/></mxCell>
        <mxCell id="c-c1" value="远端客户端 A / Nd2O3" style="swimlane;rounded=1;whiteSpace=wrap;html=1;startSize=34;fillColor=#ECFCCB;strokeColor=#65A30D;fontStyle=1;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="390" width="390" height="560" as="geometry"/></mxCell>
        <mxCell id="c-c1-1" value="Step 1&#xa;通过 GetGlobal RPC 接收完整模型 \(G_r\)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FEE7;strokeColor=#84CC16;fontSize=14;" vertex="1" parent="c-c1"><mxGeometry x="20" y="60" width="350" height="74" as="geometry"/></mxCell>
        <mxCell id="c-c1-2" value="Step 2&#xa;在客户端内部重建 \(C_{A,r}\)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FEE7;strokeColor=#84CC16;fontSize=14;" vertex="1" parent="c-c1"><mxGeometry x="20" y="154" width="350" height="62" as="geometry"/></mxCell>
        <mxCell id="c-c1-3" value="Step 3&#xa;本地训练得到 \(L_{A,r}\)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#65A30D;fontSize=14;" vertex="1" parent="c-c1"><mxGeometry x="20" y="236" width="350" height="62" as="geometry"/></mxCell>
        <mxCell id="c-c1-4" value="Step 4&#xa;默认上传 update&#xa;\(P^{up}_{A,r}=L_{A,r}-C_{A,r}\)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#65A30D;fontSize=14;" vertex="1" parent="c-c1"><mxGeometry x="20" y="318" width="350" height="74" as="geometry"/></mxCell>
        <mxCell id="c-c1-5" value="Step 5&#xa;在客户端内部做压缩 / 量化 / 编码&#xa;并通过 SubmitUpdate RPC 上传 payload_A" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=14;" vertex="1" parent="c-c1"><mxGeometry x="20" y="412" width="350" height="84" as="geometry"/></mxCell>
        <mxCell id="c-c2" value="远端客户端 B / CeO2" style="swimlane;rounded=1;whiteSpace=wrap;html=1;startSize=34;fillColor=#ECFCCB;strokeColor=#65A30D;fontStyle=1;fontSize=18;" vertex="1" parent="1"><mxGeometry x="470" y="390" width="390" height="560" as="geometry"/></mxCell>
        <mxCell id="c-c2-1" value="Step 1&#xa;通过 GetGlobal RPC 接收完整模型 \(G_r\)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FEE7;strokeColor=#84CC16;fontSize=14;" vertex="1" parent="c-c2"><mxGeometry x="20" y="60" width="350" height="74" as="geometry"/></mxCell>
        <mxCell id="c-c2-2" value="Step 2&#xa;在客户端内部重建 \(C_{B,r}\)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FEE7;strokeColor=#84CC16;fontSize=14;" vertex="1" parent="c-c2"><mxGeometry x="20" y="154" width="350" height="62" as="geometry"/></mxCell>
        <mxCell id="c-c2-3" value="Step 3&#xa;本地训练得到 \(L_{B,r}\)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#65A30D;fontSize=14;" vertex="1" parent="c-c2"><mxGeometry x="20" y="236" width="350" height="62" as="geometry"/></mxCell>
        <mxCell id="c-c2-4" value="Step 4&#xa;默认上传 update&#xa;\(P^{up}_{B,r}=L_{B,r}-C_{B,r}\)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#65A30D;fontSize=14;" vertex="1" parent="c-c2"><mxGeometry x="20" y="318" width="350" height="74" as="geometry"/></mxCell>
        <mxCell id="c-c2-5" value="Step 5&#xa;在客户端内部做压缩 / 量化 / 编码&#xa;并通过 SubmitUpdate RPC 上传 payload_B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=14;" vertex="1" parent="c-c2"><mxGeometry x="20" y="412" width="350" height="84" as="geometry"/></mxCell>
        <mxCell id="c-c3" value="远端客户端 C / La2O3" style="swimlane;rounded=1;whiteSpace=wrap;html=1;startSize=34;fillColor=#ECFCCB;strokeColor=#65A30D;fontStyle=1;fontSize=18;" vertex="1" parent="1"><mxGeometry x="900" y="390" width="390" height="560" as="geometry"/></mxCell>
        <mxCell id="c-c3-1" value="Step 1&#xa;通过 GetGlobal RPC 接收完整模型 \(G_r\)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FEE7;strokeColor=#84CC16;fontSize=14;" vertex="1" parent="c-c3"><mxGeometry x="20" y="60" width="350" height="74" as="geometry"/></mxCell>
        <mxCell id="c-c3-2" value="Step 2&#xa;在客户端内部重建 \(C_{C,r}\)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FEE7;strokeColor=#84CC16;fontSize=14;" vertex="1" parent="c-c3"><mxGeometry x="20" y="154" width="350" height="62" as="geometry"/></mxCell>
        <mxCell id="c-c3-3" value="Step 3&#xa;本地训练得到 \(L_{C,r}\)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#65A30D;fontSize=14;" vertex="1" parent="c-c3"><mxGeometry x="20" y="236" width="350" height="62" as="geometry"/></mxCell>
        <mxCell id="c-c3-4" value="Step 4&#xa;默认上传 update&#xa;\(P^{up}_{C,r}=L_{C,r}-C_{C,r}\)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#65A30D;fontSize=14;" vertex="1" parent="c-c3"><mxGeometry x="20" y="318" width="350" height="74" as="geometry"/></mxCell>
        <mxCell id="c-c3-5" value="Step 5&#xa;在客户端内部做压缩 / 量化 / 编码&#xa;并通过 SubmitUpdate RPC 上传 payload_C" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=14;" vertex="1" parent="c-c3"><mxGeometry x="20" y="412" width="350" height="84" as="geometry"/></mxCell>
        <mxCell id="c-note" value="符号说明 / Notation&#xa;\(G_r\): 服务器全局模型&#xa;\(P^{down}_{i,r}\): 下载 payload，默认是完整模型 \(G_r\)&#xa;\(C_{i,r}\): 客户端本轮训练起点&#xa;\(L_{i,r}\): 本地训练后模型&#xa;\(P^{up}_{i,r}\): 上传 payload，默认是 update \(L_{i,r}-C_{i,r}\)&#xa;\(\hat{U}_{i,r}\): 服务器解码后看到的更新" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1320" y="390" width="440" height="250" as="geometry"/></mxCell>
        <mxCell id="c-note2" value="通信量统计位置&#xa;1. 参数语义通信量：客户端在构造 `ClientResult` 时填入 metadata，服务器在 `record_round(...)` 汇总。&#xa;2. 实际传输通信量：gRPC `FederatedRpcClient` 在 `GetGlobal` / `SubmitUpdate` 周围累计 sent/received bytes。&#xa;攻击位置&#xa;攻击发生在聚合和 protocol 评测之后、本轮结束之前。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1320" y="670" width="440" height="240" as="geometry"/></mxCell>
        <mxCell id="c-e1" value="GetGlobal" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284C7;strokeWidth=2;fontSize=13;" edge="1" parent="1" source="c-s2" target="c-c1-1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c-e2" value="GetGlobal" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284C7;strokeWidth=2;fontSize=13;" edge="1" parent="1" source="c-s2" target="c-c2-1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c-e3" value="GetGlobal" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284C7;strokeWidth=2;fontSize=13;" edge="1" parent="1" source="c-s2" target="c-c3-1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c-e4" value="SubmitUpdate A" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16A34A;strokeWidth=2;fontSize=13;" edge="1" parent="1" source="c-c1-5" target="c-s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c-e5" value="SubmitUpdate B" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16A34A;strokeWidth=2;fontSize=13;" edge="1" parent="1" source="c-c2-5" target="c-s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c-e6" value="SubmitUpdate C" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16A34A;strokeWidth=2;fontSize=13;" edge="1" parent="1" source="c-c3-5" target="c-s3"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="default-multi-async" name="多节点异步">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="1" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="d-title" value="多节点异步模式（默认语义） / Multi-Node FL with Async Attack Queue (Default Semantics)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#111827;fontColor=#FFFFFF;strokeColor=#111827;fontStyle=1;fontSize=23;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1740" height="60" as="geometry"/></mxCell>
        <mxCell id="d-server" value="gRPC 协调服务器 / Coordinator" style="swimlane;rounded=1;whiteSpace=wrap;html=1;startSize=36;fillColor=#E0F2FE;strokeColor=#0284C7;fontStyle=1;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="1400" height="240" as="geometry"/></mxCell>
        <mxCell id="d-s1" value="Step 1&#xa;GetGlobal RPC 返回完整模型 \(G_r\)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;fontSize=14;" vertex="1" parent="d-server"><mxGeometry x="20" y="70" width="220" height="84" as="geometry"/></mxCell>
        <mxCell id="d-s2" value="Step 2&#xa;等待三个 SubmitUpdate RPC 到达" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontStyle=1;fontSize=14;" vertex="1" parent="d-server"><mxGeometry x="260" y="70" width="210" height="84" as="geometry"/></mxCell>
        <mxCell id="d-s3" value="Step 3&#xa;解码上传并聚合得到 \(G_{r+1}\)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=14;" vertex="1" parent="d-server"><mxGeometry x="490" y="70" width="220" height="84" as="geometry"/></mxCell>
        <mxCell id="d-s4" value="Step 4&#xa;按 protocol 口径评测并统计通信量" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;fontSize=14;" vertex="1" parent="d-server"><mxGeometry x="730" y="70" width="240" height="84" as="geometry"/></mxCell>
        <mxCell id="d-s5" value="Step 5&#xa;冻结攻击快照并立刻提交后台队列" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE7F3;strokeColor=#DB2777;fontSize=14;" vertex="1" parent="d-server"><mxGeometry x="990" y="70" width="230" height="84" as="geometry"/></mxCell>
        <mxCell id="d-s6" value="Step 6&#xa;不等待攻击完成，直接开放下一轮 GetGlobal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=14;" vertex="1" parent="d-server"><mxGeometry x="1240" y="70" width="140" height="84" as="geometry"/></mxCell>
        <mxCell id="d-queue" value="后台攻击队列 / AsyncAttackManager" style="swimlane;rounded=1;whiteSpace=wrap;html=1;startSize=36;fillColor=#FEE2E2;strokeColor=#DC2626;fontStyle=1;fontSize=18;" vertex="1" parent="1"><mxGeometry x="1460" y="100" width="300" height="240" as="geometry"/></mxCell>
        <mxCell id="d-q1" value="Step 1&#xa;接收本轮快照" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;fontSize=14;" vertex="1" parent="d-queue"><mxGeometry x="20" y="70" width="260" height="58" as="geometry"/></mxCell>
        <mxCell id="d-q2" value="Step 2&#xa;后台 worker 执行攻击" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DC2626;fontSize=14;" vertex="1" parent="d-queue"><mxGeometry x="20" y="148" width="260" height="58" as="geometry"/></mxCell>
        <mxCell id="d-q3" value="Step 3&#xa;训练结束前由 finalize() 统一 drain 队列" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;fontSize=14;" vertex="1" parent="d-queue"><mxGeometry x="20" y="226" width="260" height="58" as="geometry"/></mxCell>
        <mxCell id="d-c1" value="远端客户端 A / Nd2O3" style="swimlane;rounded=1;whiteSpace=wrap;html=1;startSize=34;fillColor=#ECFCCB;strokeColor=#65A30D;fontStyle=1;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="390" width="420" height="520" as="geometry"/></mxCell>
        <mxCell id="d-c1-1" value="1. GetGlobal RPC 接收完整模型 \(G_r\)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FEE7;strokeColor=#84CC16;fontSize=14;" vertex="1" parent="d-c1"><mxGeometry x="20" y="60" width="380" height="52" as="geometry"/></mxCell>
        <mxCell id="d-c1-2" value="2. 重建 \(C_{A,r}\) 并训练得到 \(L_{A,r}\)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#65A30D;fontSize=14;" vertex="1" parent="d-c1"><mxGeometry x="20" y="132" width="380" height="62" as="geometry"/></mxCell>
        <mxCell id="d-c1-3" value="3. 默认上传 update \(L_{A,r}-C_{A,r}\)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#65A30D;fontSize=14;" vertex="1" parent="d-c1"><mxGeometry x="20" y="214" width="380" height="62" as="geometry"/></mxCell>
        <mxCell id="d-c1-4" value="4. 客户端内部压缩 / 量化 / 编码后&#xa;通过 SubmitUpdate RPC 上传 payload_A" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=14;" vertex="1" parent="d-c1"><mxGeometry x="20" y="296" width="380" height="72" as="geometry"/></mxCell>
