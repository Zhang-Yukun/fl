<mxfile host="app.diagrams.net" agent="Codex" version="26.0.11">
  <diagram id="default-single-sync" name="单节点同步">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="1" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="a-title" value="单节点同步联邦训练（默认语义） / Single-Node Synchronous FL (Default Semantics)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#111827;fontColor=#FFFFFF;strokeColor=#111827;fontStyle=1;fontSize=23;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1740" height="60" as="geometry"/></mxCell>
        <mxCell id="a-server" value="服务器 / Server" style="swimlane;rounded=1;whiteSpace=wrap;html=1;startSize=36;fillColor=#E0F2FE;strokeColor=#0284C7;fontStyle=1;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="1720" height="240" as="geometry"/></mxCell>
        <mxCell id="a-s1" value="Step 1&#xa;持有本轮 protocol 全局模型 \(G_r\)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;fontSize=14;" vertex="1" parent="a-server"><mxGeometry x="20" y="70" width="210" height="84" as="geometry"/></mxCell>
        <mxCell id="a-s2" value="Step 2&#xa;按默认下载语义构造完整模型下发&#xa;\(P^{down}_{i,r} = G_r\)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;fontSize=14;" vertex="1" parent="a-server"><mxGeometry x="250" y="70" width="230" height="84" as="geometry"/></mxCell>
        <mxCell id="a-s3" value="Step 3&#xa;等待三个客户端都返回上传结果&#xa;同步屏障" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontStyle=1;fontSize=14;" vertex="1" parent="a-server"><mxGeometry x="500" y="70" width="210" height="84" as="geometry"/></mxCell>
        <mxCell id="a-s4" value="Step 4&#xa;把上传结果解码成协议可见更新 \(\hat{U}_{i,r}\)&#xa;并聚合得到 \(G_{r+1}\)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=14;" vertex="1" parent="a-server"><mxGeometry x="730" y="70" width="270" height="84" as="geometry"/></mxCell>
        <mxCell id="a-s5" value="Step 5&#xa;按 protocol 口径评测当前全局模型&#xa;不构造 oracle 评测模型" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;fontSize=14;" vertex="1" parent="a-server"><mxGeometry x="1020" y="70" width="240" height="84" as="geometry"/></mxCell>
        <mxCell id="a-s6" value="Step 6&#xa;统计通信量并写入 round record&#xa;位置：`server.record_round(...)`" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;fontSize=14;" vertex="1" parent="a-server"><mxGeometry x="1280" y="70" width="220" height="84" as="geometry"/></mxCell>
        <mxCell id="a-s7" value="Step 7&#xa;在本轮尾部执行攻击&#xa;同步模式下主流程等待攻击结束" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontSize=14;" vertex="1" parent="a-server"><mxGeometry x="1520" y="70" width="180" height="84" as="geometry"/></mxCell>
        <mxCell id="a-se1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;" edge="1" parent="a-server" source="a-s1" target="a-s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a-se2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;" edge="1" parent="a-server" source="a-s2" target="a-s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a-se3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;" edge="1" parent="a-server" source="a-s3" target="a-s4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a-se4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;" edge="1" parent="a-server" source="a-s4" target="a-s5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a-se5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;" edge="1" parent="a-server" source="a-s5" target="a-s6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a-se6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;" edge="1" parent="a-server" source="a-s6" target="a-s7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a-c1" value="客户端 A / Nd2O3" style="swimlane;rounded=1;whiteSpace=wrap;html=1;startSize=34;fillColor=#ECFCCB;strokeColor=#65A30D;fontStyle=1;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="390" width="390" height="560" as="geometry"/></mxCell>
        <mxCell id="a-c1-1" value="Step 1&#xa;接收完整模型下载 payload&#xa;\(P^{down}_{A,r} = G_r\)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FEE7;strokeColor=#84CC16;fontSize=14;" vertex="1" parent="a-c1"><mxGeometry x="20" y="60" width="350" height="74" as="geometry"/></mxCell>
        <mxCell id="a-c1-2" value="Step 2&#xa;执行 `prepare_client_state()`&#xa;得到实际训练起点 \(C_{A,r}\)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FEE7;strokeColor=#84CC16;fontSize=14;" vertex="1" parent="a-c1"><mxGeometry x="20" y="154" width="350" height="74" as="geometry"/></mxCell>
        <mxCell id="a-c1-3" value="Step 3&#xa;从 \(C_{A,r}\) 出发本地训练&#xa;得到 \(L_{A,r}\)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#65A30D;fontSize=14;" vertex="1" parent="a-c1"><mxGeometry x="20" y="248" width="350" height="74" as="geometry"/></mxCell>
        <mxCell id="a-c1-4" value="Step 4&#xa;默认上传 update&#xa;\(P^{up}_{A,r}=U_{A,r}=L_{A,r}-C_{A,r}\)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#65A30D;fontSize=14;" vertex="1" parent="a-c1"><mxGeometry x="20" y="342" width="350" height="74" as="geometry"/></mxCell>
        <mxCell id="a-c1-5" value="Step 5&#xa;在客户端内部执行压缩 / 量化 / 编码 / DP 保护&#xa;然后返回 `ClientResult`" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=14;" vertex="1" parent="a-c1"><mxGeometry x="20" y="436" width="350" height="84" as="geometry"/></mxCell>
        <mxCell id="a-c2" value="客户端 B / CeO2" style="swimlane;rounded=1;whiteSpace=wrap;html=1;startSize=34;fillColor=#ECFCCB;strokeColor=#65A30D;fontStyle=1;fontSize=18;" vertex="1" parent="1"><mxGeometry x="470" y="390" width="390" height="560" as="geometry"/></mxCell>
        <mxCell id="a-c2-1" value="Step 1&#xa;接收完整模型下载 payload&#xa;\(P^{down}_{B,r} = G_r\)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FEE7;strokeColor=#84CC16;fontSize=14;" vertex="1" parent="a-c2"><mxGeometry x="20" y="60" width="350" height="74" as="geometry"/></mxCell>
        <mxCell id="a-c2-2" value="Step 2&#xa;执行 `prepare_client_state()`&#xa;得到实际训练起点 \(C_{B,r}\)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FEE7;strokeColor=#84CC16;fontSize=14;" vertex="1" parent="a-c2"><mxGeometry x="20" y="154" width="350" height="74" as="geometry"/></mxCell>
        <mxCell id="a-c2-3" value="Step 3&#xa;从 \(C_{B,r}\) 出发本地训练&#xa;得到 \(L_{B,r}\)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#65A30D;fontSize=14;" vertex="1" parent="a-c2"><mxGeometry x="20" y="248" width="350" height="74" as="geometry"/></mxCell>
        <mxCell id="a-c2-4" value="Step 4&#xa;默认上传 update&#xa;\(P^{up}_{B,r}=U_{B,r}=L_{B,r}-C_{B,r}\)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#65A30D;fontSize=14;" vertex="1" parent="a-c2"><mxGeometry x="20" y="342" width="350" height="74" as="geometry"/></mxCell>
        <mxCell id="a-c2-5" value="Step 5&#xa;在客户端内部执行压缩 / 量化 / 编码 / DP 保护&#xa;然后返回 `ClientResult`" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=14;" vertex="1" parent="a-c2"><mxGeometry x="20" y="436" width="350" height="84" as="geometry"/></mxCell>
        <mxCell id="a-c3" value="客户端 C / La2O3" style="swimlane;rounded=1;whiteSpace=wrap;html=1;startSize=34;fillColor=#ECFCCB;strokeColor=#65A30D;fontStyle=1;fontSize=18;" vertex="1" parent="1"><mxGeometry x="900" y="390" width="390" height="560" as="geometry"/></mxCell>
        <mxCell id="a-c3-1" value="Step 1&#xa;接收完整模型下载 payload&#xa;\(P^{down}_{C,r} = G_r\)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FEE7;strokeColor=#84CC16;fontSize=14;" vertex="1" parent="a-c3"><mxGeometry x="20" y="60" width="350" height="74" as="geometry"/></mxCell>
        <mxCell id="a-c3-2" value="Step 2&#xa;执行 `prepare_client_state()`&#xa;得到实际训练起点 \(C_{C,r}\)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FEE7;strokeColor=#84CC16;fontSize=14;" vertex="1" parent="a-c3"><mxGeometry x="20" y="154" width="350" height="74" as="geometry"/></mxCell>
        <mxCell id="a-c3-3" value="Step 3&#xa;从 \(C_{C,r}\) 出发本地训练&#xa;得到 \(L_{C,r}\)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#65A30D;fontSize=14;" vertex="1" parent="a-c3"><mxGeometry x="20" y="248" width="350" height="74" as="geometry"/></mxCell>
        <mxCell id="a-c3-4" value="Step 4&#xa;默认上传 update&#xa;\(P^{up}_{C,r}=U_{C,r}=L_{C,r}-C_{C,r}\)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#65A30D;fontSize=14;" vertex="1" parent="a-c3"><mxGeometry x="20" y="342" width="350" height="74" as="geometry"/></mxCell>
        <mxCell id="a-c3-5" value="Step 5&#xa;在客户端内部执行压缩 / 量化 / 编码 / DP 保护&#xa;然后返回 `ClientResult`" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=14;" vertex="1" parent="a-c3"><mxGeometry x="20" y="436" width="350" height="84" as="geometry"/></mxCell>
        <mxCell id="a-note" value="符号说明 / Notation&#xa;\(G_r\): 第 \(r\) 轮开始时服务器持有的 protocol 全局模型&#xa;\(C_{i,r}\): 客户端 \(i\) 本轮真正用于训练的模型&#xa;\(L_{i,r}\): 客户端 \(i\) 本地训练后的模型&#xa;\(P^{down}_{i,r}\): 下载 payload，默认等于完整模型 \(G_r\)&#xa;\(P^{up}_{i,r}\): 上传 payload，默认等于 update \(U_{i,r}\)&#xa;\(\hat{U}_{i,r}\): 服务器解码后看到的协议可见更新" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1320" y="390" width="440" height="260" as="geometry"/></mxCell>
        <mxCell id="a-note2" value="通信量统计位置&#xa;单节点路径没有真实网络。&#xa;参数语义通信量由客户端返回的 bytes / parameters metadata 提供，&#xa;最终在 `server.record_round(...)` 中汇总。&#xa;攻击位置&#xa;攻击发生在聚合与评测之后、本轮结束之前。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1320" y="680" width="440" height="220" as="geometry"/></mxCell>
        <mxCell id="a-e1" value="download" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284C7;strokeWidth=2;fontSize=13;" edge="1" parent="1" source="a-s2" target="a-c1-1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a-e2" value="download" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284C7;strokeWidth=2;fontSize=13;" edge="1" parent="1" source="a-s2" target="a-c2-1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a-e3" value="download" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284C7;strokeWidth=2;fontSize=13;" edge="1" parent="1" source="a-s2" target="a-c3-1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a-e4" value="upload_A" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16A34A;strokeWidth=2;fontSize=13;" edge="1" parent="1" source="a-c1-5" target="a-s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a-e5" value="upload_B" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16A34A;strokeWidth=2;fontSize=13;" edge="1" parent="1" source="a-c2-5" target="a-s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a-e6" value="upload_C" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16A34A;strokeWidth=2;fontSize=13;" edge="1" parent="1" source="a-c3-5" target="a-s3"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="default-single-async" name="单节点异步">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="1" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="b-title" value="单节点异步模式（默认语义） / Single-Node FL with Async Attack Queue (Default Semantics)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#111827;fontColor=#FFFFFF;strokeColor=#111827;fontStyle=1;fontSize=23;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1740" height="60" as="geometry"/></mxCell>
        <mxCell id="b-server" value="服务器 / Server" style="swimlane;rounded=1;whiteSpace=wrap;html=1;startSize=36;fillColor=#E0F2FE;strokeColor=#0284C7;fontStyle=1;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="1400" height="240" as="geometry"/></mxCell>
        <mxCell id="b-s1" value="Step 1&#xa;下发完整模型 \(P^{down}_{i,r}=G_r\)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;fontSize=14;" vertex="1" parent="b-server"><mxGeometry x="20" y="70" width="210" height="84" as="geometry"/></mxCell>
        <mxCell id="b-s2" value="Step 2&#xa;等待三个客户端上传 update payload" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontStyle=1;fontSize=14;" vertex="1" parent="b-server"><mxGeometry x="250" y="70" width="210" height="84" as="geometry"/></mxCell>
        <mxCell id="b-s3" value="Step 3&#xa;解码上传并聚合得到 \(G_{r+1}\)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=14;" vertex="1" parent="b-server"><mxGeometry x="480" y="70" width="230" height="84" as="geometry"/></mxCell>
        <mxCell id="b-s4" value="Step 4&#xa;按 protocol 口径评测" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;fontSize=14;" vertex="1" parent="b-server"><mxGeometry x="730" y="70" width="170" height="84" as="geometry"/></mxCell>
        <mxCell id="b-s5" value="Step 5&#xa;统计通信量并写入 round record" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;fontSize=14;" vertex="1" parent="b-server"><mxGeometry x="920" y="70" width="210" height="84" as="geometry"/></mxCell>
        <mxCell id="b-s6" value="Step 6&#xa;冻结攻击快照并提交后台队列" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE7F3;strokeColor=#DB2777;fontSize=14;" vertex="1" parent="b-server"><mxGeometry x="1150" y="70" width="230" height="84" as="geometry"/></mxCell>
        <mxCell id="b-queue" value="后台攻击队列 / AsyncAttackManager" style="swimlane;rounded=1;whiteSpace=wrap;html=1;startSize=36;fillColor=#FEE2E2;strokeColor=#DC2626;fontStyle=1;fontSize=18;" vertex="1" parent="1"><mxGeometry x="1460" y="100" width="300" height="240" as="geometry"/></mxCell>
        <mxCell id="b-q1" value="Step 1&#xa;接收本轮攻击快照" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;fontSize=14;" vertex="1" parent="b-queue"><mxGeometry x="20" y="70" width="260" height="58" as="geometry"/></mxCell>
        <mxCell id="b-q2" value="Step 2&#xa;后台 worker 执行攻击" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DC2626;fontSize=14;" vertex="1" parent="b-queue"><mxGeometry x="20" y="148" width="260" height="58" as="geometry"/></mxCell>
        <mxCell id="b-q3" value="Step 3&#xa;攻击结果稍后再写回，不阻塞下一轮" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;fontSize=14;" vertex="1" parent="b-queue"><mxGeometry x="20" y="226" width="260" height="58" as="geometry"/></mxCell>
        <mxCell id="b-c1" value="客户端 A / Nd2O3" style="swimlane;rounded=1;whiteSpace=wrap;html=1;startSize=34;fillColor=#ECFCCB;strokeColor=#65A30D;fontStyle=1;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="390" width="420" height="520" as="geometry"/></mxCell>
        <mxCell id="b-c1-1" value="1. 接收完整模型 \(G_r\)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FEE7;strokeColor=#84CC16;fontSize=14;" vertex="1" parent="b-c1"><mxGeometry x="20" y="60" width="380" height="52" as="geometry"/></mxCell>
        <mxCell id="b-c1-2" value="2. 重建 \(C_{A,r}\) 并本地训练得到 \(L_{A,r}\)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#65A30D;fontSize=14;" vertex="1" parent="b-c1"><mxGeometry x="20" y="132" width="380" height="62" as="geometry"/></mxCell>
        <mxCell id="b-c1-3" value="3. 默认上传 update&#xa;\(P^{up}_{A,r}=L_{A,r}-C_{A,r}\)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#65A30D;fontSize=14;" vertex="1" parent="b-c1"><mxGeometry x="20" y="214" width="380" height="62" as="geometry"/></mxCell>
        <mxCell id="b-c1-4" value="4. 在客户端内部做压缩 / 量化 / 编码&#xa;然后返回 payload_A" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=14;" vertex="1" parent="b-c1"><mxGeometry x="20" y="296" width="380" height="72" as="geometry"/></mxCell>
